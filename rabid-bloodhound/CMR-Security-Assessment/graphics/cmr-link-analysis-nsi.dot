digraph CMR_Ecosystem {
    rankdir=TB;
    splines=polyline;
    compound=true;
    bgcolor="white";
    fontcolor="#0a0f1a";
    fontname="Helvetica";
    label="CMR Medical Systems / IDigitales — Link Analysis Graph";
    labelloc=t;
    fontsize=20;
    style=filled;
    fillcolor="white";
    pad=0.5;
    nodesep=0.5;
    ranksep=0.6;

    node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=10];

    // ============ DEVELOPER LAYER ============
    subgraph cluster_dev {
        label="DESARROLLADOR";
        fontcolor="#0a0f1a";
        fontsize=13;
        style=filled;
        fillcolor="#f1f5f9";
        color="#3b82f6";
        penwidth=2;
        
        idigitales [label="IDigitales / Cedisa Consultores\nNamespace: IDigitales.HIS.Web.Servicios.Portal", fillcolor="#3b82f6", fontcolor="white", shape=hexagon, fontsize=9];
        cmr_publisher [label="CMR Medical Systems\nGoogle Play Publisher\n14 apps publicadas", fillcolor="#3b82f6", fontcolor="white", shape=hexagon, fontsize=9];
    }

    // ============ INFRASTRUCTURE LAYER ============
    subgraph cluster_infra {
        label="INFRAESTRUCTURA";
        fontcolor="#0a0f1a";
        fontsize=13;
        style=filled;
        fillcolor="#f1f5f9";
        color="#1e293b";
        penwidth=2;

        cedisa_host [label="CEDISA (Hub Central)\nportalresultados.cedisa.do\n66.98.69.202 · IIS 8.5\nWCF: 60+ ops · Directory Listing", fillcolor="#1e293b", fontcolor="white", fontsize=9];
        cmr_apps [label="CMR Apps Server\nwww.cmr-apps.com\nHTTP (sin TLS)\ndebugMode: true", fillcolor="#1e293b", fontcolor="white", fontsize=9];
        
        internal_srv [label="RED INTERNA\nsrv-recvoz.cmr.local\neymsa-app1.internal.cmr.mx\nsrv-portal", fillcolor="#64748b", fontcolor="white", shape=note, fontsize=9];
    }

    // ============ DOMINICAN REPUBLIC ============
    subgraph cluster_rd {
        label="REPÚBLICA DOMINICANA 🇩🇴";
        fontcolor="#0a0f1a";
        fontsize=13;
        style=filled;
        fillcolor="#f8fafc";
        color="#16a34a";
        penwidth=2;

        corominas [label="Clínica Corominas\nportal.clinicacorominas.com.do\n190.167.229.27\n83 ops WSDL", fillcolor="#dc2626", fontcolor="white", fontsize=9];
        abreu [label="Clínica Abreu (CDD)\nresultados.clinicaabreu.com.do\n190.167.33.178\n70+ ops WSDL", fillcolor="#dc2626", fontcolor="white", fontsize=9];
        cardio [label="Cardio Imágenes\ncardioimagenes.cmr-apps.com\ncardioimagenes.com.do\n67 ops WSDL", fillcolor="#1e293b", fontcolor="white", fontsize=9];
        cmm [label="Centro Médico Moderno\nresultadosimagenes.cmm.do\n96 ops WSDL\nCertificado IMSS leak", fillcolor="#1e293b", fontcolor="white", fontsize=9];
        cadi [label="CADI\nportal.cadi.do\n48 ops WSDL\nSAT CFDI en app RD", fillcolor="#1e293b", fontcolor="white", fontsize=9];
        policlinica [label="Policlínica Metropolitana\npoliclinicametropolitana-apps.com\n58 ops WSDL", fillcolor="#1e293b", fontcolor="white", fontsize=9];
        higea [label="HIGEA\nhigea.cmr-apps.com\n60+ ops WSDL", fillcolor="#1e293b", fontcolor="white", fontsize=9];
    }

    // ============ INTERNATIONAL ============
    subgraph cluster_intl {
        label="INTERNACIONAL";
        fontcolor="#0a0f1a";
        fontsize=13;
        style=filled;
        fillcolor="#f8fafc";
        color="#d97706";
        penwidth=2;

        interhospital [label="InterHospital 🇪🇨\ninterhospital.com.ec\n216.198.79.1\nWCF interno", fillcolor="#1e293b", fontcolor="white", fontsize=9];
        hsh [label="Hospital San José 🇲🇽\ndisanjose.ddns.net:99\n189.173.69.27\nDDNS · HTTP · Interno", fillcolor="#1e293b", fontcolor="white", fontsize=9];
        hmc [label="Honduras Medical Center 🇭🇳\nris.hmc.hn\nBackend via CEDISA", fillcolor="#1e293b", fontcolor="white", fontsize=9];
    }

    // ============ GENERIC APPS ============
    subgraph cluster_generic {
        label="APPS CMR GENÉRICAS";
        fontcolor="#0a0f1a";
        fontsize=13;
        style=filled;
        fillcolor="#f8fafc";
        color="#64748b";
        penwidth=2;

        emesalud [label="EME Salud (Genérica)\nwww.cmr-apps.com\nHTTP · debugMode · 54 ops", fillcolor="#dc2626", fontcolor="white", fontsize=9];
        infosalud [label="InfoSalud Firmas\nwww.cmr-apps.com\nHTTP · 76 ops\n131 empleados · 77 consentimientos", fillcolor="#dc2626", fontcolor="white", fontsize=9];
        lab_tequis [label="Lab Tequis / CMR\n82 ops WSDL\neymsa-app1 leak", fillcolor="#1e293b", fontcolor="white", fontsize=9];
    }

    // ============ EDGES ============
    edge [color="#0a0f1a", penwidth=1.5, fontsize=8, fontcolor="#64748b", fontname="Helvetica"];

    // Developer → infrastructure
    idigitales -> cedisa_host [label="desarrolla/alberga", color="#3b82f6", fontcolor="#3b82f6"];
    idigitales -> cmr_apps [label="desarrolla/alberga", color="#3b82f6", fontcolor="#3b82f6"];
    idigitales -> internal_srv [label="red interna", color="#3b82f6", style=dashed, fontcolor="#3b82f6"];
    cmr_publisher -> idigitales [label="misma entidad", color="#64748b", style=dotted, fontcolor="#64748b"];

    // CEDISA Hub → clients
    cedisa_host -> corominas [label="ServidoresAdicionales()", color="#16a34a", fontcolor="#16a34a"];
    cedisa_host -> abreu [label="ServidoresAdicionales()", color="#16a34a", fontcolor="#16a34a"];
    cedisa_host -> cmm [label="ServidoresAdicionales()", color="#16a34a", fontcolor="#16a34a"];
    cedisa_host -> hmc [label="backend proxy", color="#d97706", style=dashed, fontcolor="#d97706"];

    // cmr-apps → clients
    cmr_apps -> cardio [label="alberga", color="#16a34a", fontcolor="#16a34a"];
    cmr_apps -> higea [label="alberga", color="#16a34a", fontcolor="#16a34a"];
    cmr_apps -> emesalud [label="alberga (HTTP)", color="#dc2626", style=bold, fontcolor="#dc2626"];
    cmr_apps -> infosalud [label="alberga (HTTP)", color="#dc2626", style=bold, fontcolor="#dc2626"];

    // Internal network
    internal_srv -> cedisa_host [label="resuelve internamente", color="#64748b", style=dashed, fontcolor="#64748b"];

    // Cross-connections
    corominas -> internal_srv [label="redirect a srv-portal", color="#64748b", style=dotted, dir=both, fontcolor="#64748b"];
    abreu -> internal_srv [label="redirect a srv-recvoz", color="#64748b", style=dotted, dir=both, fontcolor="#64748b"];
    cmm -> internal_srv [label="redirect a srv-recvoz", color="#64748b", style=dotted, dir=both, fontcolor="#64748b"];
    cardio -> internal_srv [label="redirect a srv-portal", color="#64748b", style=dotted, dir=both, fontcolor="#64748b"];

    // International - isolated but same WSDL
    interhospital -> idigitales [label="mismo namespace WCF", color="#d97706", style=dotted, fontcolor="#d97706"];
    hsh -> idigitales [label="mismo namespace WCF", color="#d97706", style=dotted, fontcolor="#d97706"];

    // Shared vulnerability label
    cmrservice05 [label="🔴 cmrservice05\nContraseña compartida\nGetContrasenaTabletas\n9/9 hosts", 
                  shape=note, fillcolor="#dc2626", fontcolor="white", fontsize=11, penwidth=2, color="#991b1b"];
    cmrservice05 -> cedisa_host [label="password leak", color="#dc2626", style=bold, constraint=false, fontcolor="#dc2626", penwidth=2];
    cmrservice05 -> cmr_apps [label="password leak", color="#dc2626", style=bold, constraint=false, fontcolor="#dc2626", penwidth=2];

    // Legend
    subgraph cluster_legend {
        label="LEYENDA";
        fontcolor="#0a0f1a";
        fontsize=11;
        style=filled;
        fillcolor="#f1f5f9";
        color="#e2e8f0";
        penwidth=1;
        fontname="Helvetica";

        legend_node1 [label="🔴 CRÍTICO / Target NSI", fillcolor="#dc2626", fontcolor="white", fontsize=9];
        legend_node2 [label="🔵 Infraestructura", fillcolor="#1e293b", fontcolor="white", fontsize=9];
        legend_node3 [label="🟡 Desarrollador", fillcolor="#3b82f6", fontcolor="white", fontsize=9];
        legend_edge1 [label="── conexión directa", shape=none, fillcolor="none", fontsize=9];
        legend_edge2 [label="- - - conexión interna", shape=none, fillcolor="none", fontsize=9];
        legend_edge3 [label="····· referencia débil", shape=none, fillcolor="none", fontsize=9];
    }
}
