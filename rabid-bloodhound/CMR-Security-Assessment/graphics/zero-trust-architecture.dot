digraph ZeroTrustWCF {
    rankdir=TB;
    compound=true;
    splines=ortho;
    node [fontname="Arial", fontsize=10];
    edge [fontname="Arial", fontsize=9];
    pad=0.5;
    overlap=false;
    
    // ===== COLOR SCHEME =====
    // Internet: lightblue
    // IDP: lightcoral
    // Kong: lightgoldenrodyellow
    // WCF: lightcyan
    // DB: lightgreen
    // Security: mistyrose
    
    // ===== SUBGRAPHS =====
    subgraph cluster_internet {
        label="🌐  Internet (Untrusted)";
        style=filled;
        fillcolor="#E3F2FD";
        color="#1565C0";
        fontsize=12;
        fontweight=bold;
        
        FA1 [label="📱 Flutter App\nCorominas", shape=box, style=filled, fillcolor="#BBDEFB"];
        FA2 [label="📱 Flutter App\nAbreu", shape=box, style=filled, fillcolor="#BBDEFB"];
        FA3 [label="📱 Flutter App\nCMM", shape=box, style=filled, fillcolor="#BBDEFB"];
        FA4 [label="📱 Otras 11 Apps\n(HIGEA, Cardio, etc.)", shape=box, style=filled, fillcolor="#BBDEFB"];
    }
    
    subgraph cluster_idp {
        label="🔐  Identity Provider Layer";
        style=filled;
        fillcolor="#FCE4EC";
        color="#C62828";
        fontsize=12;
        fontweight=bold;
        
        KC [label="Keycloak / Azure AD\n• OAuth2/OIDC Server\n• Client Credentials Grant\n• JWKS Endpoint", shape=box3d, style=filled, fillcolor="#F8BBD0"];
        VAULT [label="HashiCorp Vault\n• Credenciales rotables\n• Hospital Secrets\n• Auto-rotación 90d", shape=box3d, style=filled, fillcolor="#F8BBD0"];
    }
    
    subgraph cluster_kong {
        label="🛡️  DMZ — API Gateway (Kong)";
        style=filled;
        fillcolor="#FFF8E1";
        color="#F57F17";
        fontsize=12;
        fontweight=bold;
        
        KONG [label="Kong Gateway\n━━━━━━━━━━━━━━━━━━━\n• TLS Termination (1.3)\n• JWT Validation (JWKS)\n• Rate Limiting (Redis)\n• WSDL Protection (ACL)\n• IP Reputation\n• CORS Control\n• Bot Detection\n• Request Transformer", shape=box, style=filled, fillcolor="#FFECB3"];
        REDIS [label="Redis Cluster\nRate Limit Backend", shape=cylinder, style=filled, fillcolor="#FFECB3"];
    }
    
    subgraph cluster_internal {
        label="🔒  Red Interna Aislada (Trusted but Verified)";
        style=filled;
        fillcolor="#E0F2F1";
        color="#00695C";
        fontsize=12;
        fontweight=bold;
        
        subgraph cluster_wcf {
            label="WCF Backend (.NET 4.0)";
            style=filled;
            fillcolor="#B2DFDB";
            color="#00796B";
            fontsize=10;
            
            WCF1 [label="ServicioPortal.svc\nHospital Corominas\n(ZeroTrustAuthManager)", shape=box, style=filled, fillcolor="#80CBC4"];
            WCF2 [label="ServicioPortal.svc\nHospital Abreu\n(ZeroTrustAuthManager)", shape=box, style=filled, fillcolor="#80CBC4"];
            WCF3 [label="ServicioPortal.svc\nHospital CMM\n(ZeroTrustAuthManager)", shape=box, style=filled, fillcolor="#80CBC4"];
            WCF4 [label="ServicioPortal.svc\nOtros Hospitales\n(Shared + RLS)", shape=box, style=filled, fillcolor="#80CBC4"];
        }
        
        subgraph cluster_db {
            label="Capa de Datos (SQL Server)";
            style=filled;
            fillcolor="#C8E6C9";
            color="#2E7D32";
            fontsize=10;
            
            DB1 [label="Schema: corominas\nDatos aislados", shape=cylinder, style=filled, fillcolor="#A5D6A7"];
            DB2 [label="Schema: abreu\nDatos aislados", shape=cylinder, style=filled, fillcolor="#A5D6A7"];
            DB3 [label="Schema: cmm\nDatos aislados", shape=cylinder, style=filled, fillcolor="#A5D6A7"];
            DB4 [label="Schema Compartido\n+ Row-Level Security", shape=cylinder, style=filled, fillcolor="#A5D6A7"];
        }
        
        subgraph cluster_siem {
            label="Monitoreo y Auditoría";
            style=filled;
            fillcolor="#F3E5F5";
            color="#6A1B9A";
            fontsize=10;
            
            SIEM [label="Wazuh SIEM / Splunk\n• Audit Trail Immutable\n• Dashboards\n• Alertas (PagerDuty)", shape=tab, style=filled, fillcolor="#CE93D8"];
        }
        
        subgraph cluster_admin {
            label="Administración Interna";
            style=filled;
            fillcolor="#FFF3E0";
            color="#E65100";
            fontsize=10;
            
            ADM [label="Admins IDigitales\n(VPN + 2FA)", shape=box, style=filled, fillcolor="#FFCC80"];
            MEX [label="WSDL MEX Service\n(Solo VPN / Interno)", shape=box, style=filled, fillcolor="#FFCC80"];
        }
    }
    
    // ===== EDGES =====
    // Internet → Kong
    FA1 -> KONG [label="  JWT + SOAP (TLS 1.3)", color="#1565C0", penwidth=1.5];
    FA2 -> KONG [label="  JWT + SOAP (TLS 1.3)", color="#1565C0", penwidth=1.5];
    FA3 -> KONG [label="  JWT + SOAP (TLS 1.3)", color="#1565C0", penwidth=1.5];
    FA4 -> KONG [label="  JWT + SOAP (TLS 1.3)", color="#1565C0", penwidth=1.5];
    
    // Kong → IDP (JWKS validation)
    KONG -> KC [label="  GET /certs (JWKS)", color="#C62828", penwidth=1, style=dashed];
    
    // Kong → Redis
    KONG -> REDIS [label="  Rate Limit State", color="#F57F17", penwidth=1, style=dotted];
    
    // Kong → WCF
    KONG -> WCF1 [label="  SOAP + HospitalAuth Header", color="#00796B", penwidth=1.5];
    KONG -> WCF2 [label="  SOAP + HospitalAuth Header", color="#00796B", penwidth=1.5];
    KONG -> WCF3 [label="  SOAP + HospitalAuth Header", color="#00796B", penwidth=1.5];
    KONG -> WCF4 [label="  SOAP + HospitalAuth Header", color="#00796B", penwidth=1.5];
    
    // WCF → DB
    WCF1 -> DB1 [label="  Session Context: corominas", color="#2E7D32", penwidth=1];
    WCF2 -> DB2 [label="  Session Context: abreu", color="#2E7D32", penwidth=1];
    WCF3 -> DB3 [label="  Session Context: cmm", color="#2E7D32", penwidth=1];
    WCF4 -> DB4 [label="  Session Context: hospital_id", color="#2E7D32", penwidth=1];
    
    // All WCF → Audit
    WCF1 -> SIEM [label="  Audit Events", color="#6A1B9A", penwidth=1, style=dashed];
    WCF2 -> SIEM [label="  Audit Events", color="#6A1B9A", penwidth=1, style=dashed];
    WCF3 -> SIEM [label="  Audit Events", color="#6A1B9A", penwidth=1, style=dashed];
    WCF4 -> SIEM [label="  Audit Events", color="#6A1B9A", penwidth=1, style=dashed];
    
    // Admin
    ADM -> MEX [label="  WSDL Request (Autorizado)", color="#E65100", penwidth=1, style=dashed];
    ADM -> KONG [label="  Admin Config", color="#E65100", penwidth=1, style=dashed];
    
    // Vault → Keycloak
    VAULT -> KC [label="  Rotación 90d", color="#C62828", penwidth=1, style=dotted];
}
